# Copy this file to .env and fill in real values.
# .env must live OUTSIDE public/ (it already does, at the project root) so it
# is never served by the webserver. On cPanel, prefer placing this file one
# level ABOVE public_html if your hosting plan allows it (see
# CPANEL_DEPLOYMENT_NOTES.md) - APP_ROOT below makes that relocation a
# one-line change instead of a code change.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=change-me-to-a-random-64-char-string-generated-once-per-install

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=partnership_finance_php
DB_USERNAME=pfsuser
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

SESSION_LIFETIME_MINUTES=120
SESSION_COOKIE_NAME=pfs_session
SESSION_COOKIE_SECURE=true

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
