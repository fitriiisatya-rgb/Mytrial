# Defense in depth ONLY - the real fix is pointing the domain's document
# root at public/, per CPANEL_DEPLOYMENT_NOTES.md. If that is not
# possible on a given hosting plan and this project root ends up being
# served directly, this file denies access to everything except
# public/ so app code, config, and .env are never fetchable by URL.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
