# Supabase project settings — get these from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the client. Used for the few operations
# that must bypass RLS deliberately (e.g. inviting an investor and
# creating their auth user) — never for general queries.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
