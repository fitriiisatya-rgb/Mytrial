# Supabase project settings — get these from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the client. Used for the few operations
# that must bypass RLS deliberately (e.g. inviting an investor and
# creating their auth user) — never for general queries.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cashflow module: Google Sheet sync -------------------------------
# Service account with "Viewer" access shared on the target Google Sheet.
# Create one in Google Cloud Console > IAM > Service Accounts, enable the
# Google Sheets API, download its JSON key, then set these two values.
# Server-only — never exposed to the client, never committed.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key from the JSON key file with literal \n for newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Shared secret for the unattended cron sync endpoint
# (POST /api/cashflow/cron-sync with `Authorization: Bearer $CRON_SECRET`).
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-secret

# Optional fallback if the spreadsheet_id row in sync_config is ever missing.
CASHFLOW_SPREADSHEET_ID=1D6Hh7LCC9L2nRwqEguc5JLM9kOUl9WyTY3o4v5gs_RQ
